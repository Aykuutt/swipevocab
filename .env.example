# Bu dosyayı .env.local olarak kopyala ve Supabase değerlerini yaz.
# Supabase panelinde: Project Settings > API Keys (ya da Connect düğmesi).
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Google AdSense (isteğe bağlı). Boş bırakılırsa uygulamada reklam olmaz.
# AdSense panelinde: Hesap > Hesap bilgileri > Yayıncı kimliği (ca-pub-...). Reklam birimi kimliği: Reklamlar > Reklam birimine göre.
VITE_ADSENSE_CLIENT=
VITE_ADSENSE_SLOT_LESSON_END=
